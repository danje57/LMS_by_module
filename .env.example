# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lms:password@localhost:5432/lms_by_module

# ── NextAuth ──────────────────────────────────────────────────────────────────
# AUTH_URL n'est pas nécessaire grâce à trustHost:true
# Il s'adapte automatiquement à localhost, IP LAN, et HTTPS
AUTH_SECRET=changez-ce-secret-en-production

# En production HTTPS, décommentez et adaptez :
# AUTH_URL=https://votre-domaine.com

# ── Chemins de stockage (volumes Docker) ─────────────────────────────────────
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups

# ── Application (utilisé dans les emails) ────────────────────────────────────
APP_URL=https://votre-domaine.com
# Chemin relatif vers le logo dans /public (optionnel, ex: /logo.png)
MAIL_LOGO_PATH=
# Nom affiché dans les emails
MAIL_APP_NAME=LMS

# ── Notifications email ───────────────────────────────────────────────────────
# Fournisseur : smtp (Gmail, Exchange SMTP AUTH) ou graph (Exchange Online / Microsoft 365)
MAIL_PROVIDER=smtp

# ── Option A : SMTP (Gmail ou Exchange Online avec SMTP AUTH) ─────────────────
# Gmail    : MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SECURE=false
# Exchange : MAIL_HOST=smtp.office365.com  MAIL_PORT=587  MAIL_SECURE=false
# Gmail    : créer un "Mot de passe d'application" dans les paramètres Google
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=votre-email@gmail.com
MAIL_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=votre-email@gmail.com
MAIL_FROM_NAME=LMS Notifications

# ── Option B : Microsoft Graph API (Exchange Online / Microsoft 365) ──────────
# Prérequis : app Azure AD avec autorisation Mail.Send (application permission)
# MAIL_PROVIDER=graph
# MAIL_GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MAIL_GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MAIL_GRAPH_CLIENT_SECRET=votre-secret-client
# MAIL_GRAPH_FROM=expediteur@votre-domaine.com

# ── Cron notifications (deadline warning + expired) ───────────────────────────
# Secret pour protéger le endpoint /api/cron/notifications
# Appel cron Linux (8h chaque matin) :
#   0 8 * * * curl -s -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/notifications
CRON_SECRET=changez-ce-secret-cron
