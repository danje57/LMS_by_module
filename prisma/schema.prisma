generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  passwordHash   String?
  isActive       Boolean              @default(true)
  isProtected    Boolean              @default(false)
  locale         String               @default("fr")
  theme          String               @default("system")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  authAccounts   AuthAccount[]
  assignments      CourseAssignment[]
  assignedCourses  CourseAssignment[]   @relation("AssignedByUser")
  courseProgress   UserCourseProgress[]
  quizResults    UserQuizResult[]
  certificates   Certificate[]
  roles          UserRole[]
  teams          UserTeam[]
  managedTeams   Team[]               @relation("ManagedTeams")
  createdCourses Course[]             @relation("CreatedCourses")
  notifications  Notification[]

  @@map("users")
}

model AuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Role {
  id          String     @id @default(cuid())
  name        RoleType   @unique
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Team {
  id        String     @id @default(cuid())
  name      String
  managerId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  manager            User?              @relation("ManagedTeams", fields: [managerId], references: [id], onDelete: SetNull)
  members            UserTeam[]
  assignedByTeam     CourseAssignment[] @relation("AssignedByTeam")

  @@map("teams")
}

model UserTeam {
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("user_teams")
}

model Course {
  id               String               @id @default(cuid())
  title            String
  duration         Int
  hasQuiz              Boolean              @default(false)
  passingScore         Int?
  scoreVideoQuestions  Boolean              @default(false)
  showVideoAnswers     Boolean              @default(true)
  filePath         String               @default("")
  originalFileName String               @default("")
  fileSize         BigInt               @default(0)
  fileHash         String?
  thumbnailPath    String?
  category         String?
  isActive         Boolean              @default(true)
  courseType       CourseType           @default(h5p)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdById      String?
  createdBy        User?                @relation("CreatedCourses", fields: [createdById], references: [id], onDelete: SetNull)
  assets           CourseAsset[]
  assignments      CourseAssignment[]
  progress         UserCourseProgress[]
  quizResults      UserQuizResult[]
  certificates     Certificate[]
  questions        QuizQuestion[]
  nativeVideo      NativeVideo?

  @@map("courses")
}

model NativeVideo {
  id        String                @id @default(cuid())
  courseId  String                @unique
  course    Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videoPath String
  fileHash  String?
  duration  Float?
  questions NativeVideoQuestion[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("native_videos")
}

model NativeVideoQuestion {
  id            String       @id @default(cuid())
  videoId       String
  video         NativeVideo  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  timestamp     Float
  question      String
  choices       Json
  order         Int          @default(0)
  type          QuestionType @default(qcm)
  allowMultiple Boolean      @default(false)
  explanation   String?
  createdAt     DateTime     @default(now())

  @@map("native_video_questions")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  courseId      String
  order         Int
  type          QuestionType @default(qcm)
  question      String
  choiceA       String?
  choiceB       String?
  choiceC       String?
  choiceD       String?
  choiceE       String?
  choiceF       String?
  choiceG       String?
  choiceH       String?
  choiceI       String?
  choiceJ       String?
  correctAnswer  String
  allowMultiple  Boolean      @default(false)
  explanation    String?
  createdAt      DateTime     @default(now())
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model CourseAsset {
  id        String   @id @default(cuid())
  courseId  String
  filePath  String
  fileType  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_assets")
}

model CourseAssignment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  assignedAt      DateTime  @default(now())
  dueDate         DateTime?
  assignedById    String?
  assigningTeamId String?
  notifiedAssignedAt DateTime?
  notifiedWarningAt  DateTime?
  notifiedExpiredAt  DateTime?
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy      User?     @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)
  assigningTeam   Team?     @relation("AssignedByTeam", fields: [assigningTeamId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@map("course_assignments")
}

model UserCourseProgress {
  id            String    @id @default(cuid())
  userId        String
  courseId      String
  progress      Int       @default(0)
  visitedSlides Int[]     @default([])
  startedAt     DateTime  @default(now())
  lastAccessAt  DateTime  @default(now())
  completedAt   DateTime?
  xapiState     Json?
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("user_course_progress")
}

model UserQuizResult {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  attempt      Int      @default(1)
  score        Int
  passingScore Int
  passed       Boolean
  answersData  Json?
  completedAt  DateTime @default(now())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quiz_results")
}

model Certificate {
  id           String    @id @default(cuid())
  userId       String
  courseId     String?
  courseTitle  String
  completedAt  DateTime
  hasQuiz      Boolean   @default(false)
  quizPassed   Boolean?
  quizScore    Int?
  passingScore Int?
  issuedAt     DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("certificates")
}

model MailSetting {
  id                String   @id @default(cuid())
  provider          String   @default("smtp")
  fromName          String   @default("LMS Notifications")
  appUrl            String?
  // SMTP
  smtpHost          String?
  smtpPort          Int      @default(587)
  smtpSecure        Boolean  @default(false)
  smtpUser          String?
  smtpPass          String?
  smtpFrom          String?
  // Microsoft Graph (Exchange Online)
  graphTenantId     String?
  graphClientId     String?
  graphClientSecret String?
  graphFrom         String?
  // Cron
  cronSecret        String?
  updatedAt         DateTime @updatedAt

  @@map("mail_settings")
}

model BrandingSetting {
  id                     String   @id @default(cuid())
  appName                String   @default("LMS")
  logoPath               String?
  bannerPath             String?
  loginNotice            String?
  auditLogRetentionDays  Int      @default(180)
  seasonalThemesEnabled      Boolean   @default(false)
  maintenanceBannerEnabled   Boolean   @default(false)
  maintenanceBannerMessage   String?
  maintenanceBannerColor     String    @default("orange")
  maintenanceBannerEndsAt    DateTime?
  updatedAt                  DateTime  @updatedAt

  @@map("branding_settings")
}

model BackupRecord {
  id        String   @id @default(cuid())
  filename  String
  filePath  String
  sizeBytes BigInt?
  createdAt DateTime @default(now())
  createdBy String?
  notes     String?

  @@map("backup_records")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String?
  actorName   String?
  actorEmail  String?
  action      String
  targetId    String?
  targetLabel String?
  details     Json?

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])

  @@map("audit_logs")
}

enum RoleType {
  superadmin
  admin
  manager
  creator
  learner
}

enum QuestionType {
  qcm
  vrai_faux
}

enum CourseType {
  h5p
  native_video
}
